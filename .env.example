# --- Providers (all optional — the built-in `mock` provider works with zero keys) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Ingestion auth (SDK -> ingestion API) ---
ARGUS_API_KEY=dev-argus-key

# --- Django ---
DJANGO_SECRET_KEY=dev-only-not-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Infrastructure (compose overrides these per-service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
