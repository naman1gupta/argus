# ---------------------------------------------------------------------------
# LLM providers — ALL OPTIONAL.
# The built-in `mock` provider needs no key, so every feature works out of the box.
# Any key you add activates that provider in the chat model picker on restart;
# the same SDK instrumentation captures all of them (see docs/MODELS.md).
#
#   FREE TIER (recommended for review):
#     GROQ_API_KEY     → console.groq.com/keys        models: llama-3.3-70b-versatile, llama-3.1-8b-instant
#     GEMINI_API_KEY   → aistudio.google.com/apikey   models: gemini-flash-latest, gemini-3-flash-preview, gemini-3.1-flash-lite
#
#   PAID (implemented, no key bundled with this submission):
#     ANTHROPIC_API_KEY → console.anthropic.com       models: claude-sonnet-4-5, claude-haiku-4-5
#     OPENAI_API_KEY    → platform.openai.com         models: gpt-5.4-mini, gpt-5.4
#     XAI_API_KEY       → console.x.ai                models: grok-4, grok-4-fast
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Provider/model selected by the chat UI on load. Falls back to the keyless
# `mock` provider automatically when this provider has no key configured.
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# --- Demo login credentials (seeded by `manage.py bootstrap_demo`) ---
DEMO_ADMIN_PASSWORD=argus-admin
DEMO_MEMBER_PASSWORD=argus-member

# --- SDK dogfooding: the bundled chat app ingests through this key ---
ARGUS_ENDPOINT=http://localhost:8000/api/v1
CHAT_INGEST_KEY=argus_sk_dev-chat-key-change-me

# --- Rate limits ---
INGEST_RATE_LIMIT_PER_MIN=300
PROVIDER_RATE_LIMIT_PER_MIN=20

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# --- Infrastructure (compose overrides hosts per-service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Host port mappings — change if 5432/29092 are already in use on your machine.
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=29092
