# --- LLM providers (all optional — the built-in `mock` provider works with zero keys) ---
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here

# --- Demo login credentials (seeded by `manage.py bootstrap_demo`) ---
DEMO_ADMIN_PASSWORD=argus-admin
DEMO_MEMBER_PASSWORD=argus-member

# --- SDK dogfooding: the bundled chat app ingests through this key ---
ARGUS_ENDPOINT=http://localhost:8000/api/v1
CHAT_INGEST_KEY=argus_sk_dev-chat-key-change-me

# --- Rate limits ---
INGEST_RATE_LIMIT_PER_MIN=300
PROVIDER_RATE_LIMIT_PER_MIN=20

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Infrastructure (compose overrides hosts per-service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
